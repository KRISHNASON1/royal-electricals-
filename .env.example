# API Configuration (Optional - for future backend integration)
# NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Google Maps API Key (Optional - for enhanced maps)
# NEXT_PUBLIC_GOOGLE_MAPS_KEY=your_google_maps_key_here

# Contact Email (for notifications - optional)
# CONTACT_EMAIL=royalelectrical_taloja@rediffmail.com

# Analytics (Optional)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Royal enquiry email delivery. Use credentials for an authorised sending account.
# Enquiries are delivered to royalelectrical_taloja@rediffmail.com.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Paid React Bits components (including Album Rail).
# Set your purchased license key in .env.local; never commit the real key.
REACTBITS_LICENSE_KEY=
